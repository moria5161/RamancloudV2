include README.md LOCAL_SETUP.md MCP.md DESKTOP.md
include frontend/package.json frontend/package-lock.json frontend/index.html frontend/vite.config.js
include frontend/structure-editor.html
include backend/requirements*.txt
recursive-include backend/algorithms *.py *.json *.xyz
recursive-include frontend/src *.js *.jsx *.css
recursive-include frontend/public *
recursive-include desktop *.py *.spec *.txt
recursive-include scripts *.cjs *.py
recursive-include tests *.py
recursive-include backend/tests *.py
prune frontend/node_modules
prune frontend/dist
prune backend/runtime
prune backend/.venv
prune backend/algorithms/baseline_cor/models
prune backend/algorithms/denoising/f2p/models
prune backend/algorithms/structure_spectrum/models
prune desktop/build
prune desktop/dist
prune desktop/artifacts
prune desktop/test-results
global-exclude __pycache__ *.py[cod]
global-exclude *.pth *.pt *.ckpt *.safetensors *.onnx
