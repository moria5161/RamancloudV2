# Optional chat provider override. No .env file is loaded automatically.
# Export these variables in your shell or set them in the server environment.
# Chat and intelligent spectrum analysis share backend/ai_config.json (Ollama).

# Shared self-hosted Ollama configuration:
# RAMANCLOUD_AI_PROVIDER=ollama
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=qwen3:4b-instruct-2507-q4_K_M
# OLLAMA_MODELS=D:\Ollama\models
# OLLAMA_TIMEOUT_SECONDS=180
# OLLAMA_COMMAND_TIMEOUT_SECONDS=120

# Shared online provider configuration, instead of ai_config.json:
# RAMANCLOUD_AI_PROVIDER=deepseek
# DEEPSEEK_API_KEY=change_me
# RAMANCLOUD_AI_MODEL=deepseek-flash
