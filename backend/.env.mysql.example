# RamanCloud MySQL deployment example
#
# The application reads environment variables from the operating system.
# Do not commit real passwords.

# Preferred single connection string:
DATABASE_URL=mysql+pymysql://ramancloud_user:change_me@127.0.0.1:3306/ramancloud?charset=utf8mb4

# Or use separated variables instead of DATABASE_URL:
# MYSQL_HOST=127.0.0.1
# MYSQL_PORT=3306
# MYSQL_USER=ramancloud_user
# MYSQL_PASSWORD=change_me
# MYSQL_DATABASE=ramancloud
# MYSQL_CHARSET=utf8mb4

# Uploaded files are stored locally by default.
# Point this to a mounted disk/shared volume in production if needed.
# RAMANCLOUD_STORAGE_DIR=D:\ramancloud_uploads

# S3-compatible object storage for uploaded files.
# Works with AWS S3, Cloudflare R2, MinIO, and other S3-compatible providers.
# RAMANCLOUD_STORAGE_BACKEND=s3
# RAMANCLOUD_S3_BUCKET=ramancloud-uploads
# RAMANCLOUD_S3_PREFIX=ramancloud/uploads
# RAMANCLOUD_S3_REGION=ap-east-1
# RAMANCLOUD_S3_ENDPOINT_URL=https://example-account-id.r2.cloudflarestorage.com
# RAMANCLOUD_S3_ACCESS_KEY_ID=change_me
# RAMANCLOUD_S3_SECRET_ACCESS_KEY=change_me
