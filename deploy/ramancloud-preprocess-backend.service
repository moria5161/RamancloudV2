[Unit]
Description=RamanCloud V2 Preprocessing Backend
After=network.target

[Service]
Type=simple
User=room
WorkingDirectory=/media/ramancloud_rebuild/backend
ExecStart=/media/ramancloud_rebuild/backend/.venv/bin/python app.py
Restart=always
RestartSec=3
Environment=PYTHONUNBUFFERED=1
Environment=RAMANCLOUD_WEB_SECURITY=1
Environment=RAMANCLOUD_WEB_ORIGINS=https://ramancloud.xmu.edu.cn
Environment=RAMANCLOUD_SESSION_COOKIE_PATH=/ramancloud-api/
Environment=OMP_NUM_THREADS=4
Environment=OPENBLAS_NUM_THREADS=4
Environment=MKL_NUM_THREADS=4
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
UMask=0077
MemoryHigh=2G
MemoryMax=4G
CPUQuota=400%
TasksMax=256

[Install]
WantedBy=multi-user.target
