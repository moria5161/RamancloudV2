# Install as /etc/ramancloud-alpha.env, owned by root with permissions 0600.
RAMANCLOUD_DATA_DIR=/var/lib/ramancloud-alpha
RAMANCLOUD_ALLOWED_ORIGINS=
RAMANCLOUD_STORAGE_BACKEND=local

# Ollama on the server, reachable only over loopback.
RAMANCLOUD_AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:1.7b
OLLAMA_KEEP_ALIVE=30s

# Provision AirNet from the group's approved private model source.
RAMANCLOUD_AIRNET_MODEL=/var/lib/ramancloud-alpha/models/0925RU_statedict.pth
